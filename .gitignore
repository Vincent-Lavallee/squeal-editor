node_modules/

# Vite build output; regenerate with `bun run build`.
resources/

# Fetched by `neu update` (runs on postinstall), not source.
bin/
frontend/public/js/

# Compiled extension binary; regenerate with `bun run build:ext`.
extensions/db/squeal-db-ext
extensions/db/squeal-db-ext.exe

# The SQLite test fixture; regenerate with `bun run test:db:up`. It is seeded
# from SQLITE_SEED the same way the containers are, so it is output, not source.
tests/fixtures/shop.db

# Neutralino runtime scratch.
.tmp/
neutralinojs.log


dist/
# Temp file bun leaves behind when `bun build --compile` is interrupted.
.*.bun-build

# Inno Setup writes the installer and its signature next to the script.
installer/*.exe
installer/*.sig
SHA256SUMS*
